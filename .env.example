# Copy to .env and fill in. Do NOT commit .env.

# Database — Neon (or any Postgres) connection string
# Use Neon's POOLED connection string for serverless (recommended).
DATABASE_URL=

# Anthropic API — for AI features (parseCapture, agentSuggestions)
ANTHROPIC_API_KEY=

# SMTP — for magic-link emails (own SMTP server per ADR 0015)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth — register an app at https://console.cloud.google.com
# Authorized redirect URI: <APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App URL — used for OAuth redirects, magic-link emails, etc.
# Local dev: http://localhost:5173
# Production: https://your-domain.com
APP_URL=http://localhost:5173

# Session secret — random 32+ char string, used to derive cookie names / CSRF tokens
SESSION_SECRET=
