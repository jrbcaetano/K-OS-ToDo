# Copy to .env and fill in. Do NOT commit .env.

# Database — Neon (or any Postgres) connection string
# Use Neon's POOLED connection string for serverless (recommended).
DATABASE_URL=

# SMTP — for magic-link emails (own SMTP server per ADR 0015)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth — register an app at https://console.cloud.google.com
# Authorized redirect URI: <APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App URL — used for OAuth redirects, magic-link emails, etc.
# Local dev: http://localhost:5173
# Production: https://your-domain.com
APP_URL=http://localhost:5173

# Session secret — random 32+ char string. Reserved; not used yet.
SESSION_SECRET=

# Cron secret — random 32+ char string. Vercel Cron sends this in
# `Authorization: Bearer <CRON_SECRET>` to /api/cron/* routes.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Agent services (per [[0020 - agent-native-architecture-agents-external-to-platform]])
# Agents live OUTSIDE this platform. They authenticate against /api/* with a
# workspace-scoped key issued via POST /api/agents (cookie-auth, human-only).
# This platform does NOT call any LLM; provider keys (Anthropic, OpenAI, etc.)
# belong in the agent service's environment, not here.
# ─────────────────────────────────────────────────────────────────────────────
